{
  "name": "pahadi-safar-fullstack",
  "version": "1.0.0",
  "private": true,
  "description": "Pahadi Safar full-stack tour and travel platform",
  "scripts": {
    "dev": "node_modules/node/bin/node node_modules/concurrently/dist/bin/index.js -n FRONTEND,BACKEND -c green,blue npm:client npm:server",
    "client": "npm --prefix frontend run dev",
    "server": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "start:frontend": "npm --prefix frontend run start",
    "start:backend": "npm --prefix backend run start",
    "install:all": "npm install --prefix frontend && npm install --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "node": "^24.18.1"
  }
}
